    "gen:api": "openapi-typescript ../contracts/openapi.json -o ./src/services/schema.d.ts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "openapi-fetch": "^0.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.2"
  }
